{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash scripts/check.sh)",
      "Bash(python3 -m unittest *)",
      "Bash(python3 sitegen/build.py)",
      "Bash(python3 scripts/check_site.py)"
    ],
    "ask": [
      "Bash(git push origin main*)",
      "Bash(git push origin *:main*)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/scripts/hooks/after-edit.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/scripts/hooks/before-stop.sh" }
        ]
      }
    ]
  }
}
